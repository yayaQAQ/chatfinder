<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The embedded MCP server binds 127.0.0.1 so local agents can query the
         archive. Loopback only; the sandbox still needs the server entitlement.
         Must mirror entitlements.plist — this file is what the local sandbox
         test build is signed with. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
